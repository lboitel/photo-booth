# Run scan_printer.py to discover these values
PRINTER_ADDRESS=XX:XX:XX:XX:XX:XX
PRINTER_CHAR_UUID=0000ff02-0000-1000-8000-00805f9b34fb
PRINTER_WIDTH_PX=384

# Rotate the photo before printing (90 = landscape photo on a narrow receipt)
PRINTER_ROTATE=90

# >1.0 lightens the print (less ink), 1.0 = no change
PRINTER_BRIGHTNESS=1.4
